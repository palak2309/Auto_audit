# ==============================================================================
# AutoAudit Environment Variables Configuration
# Configure these variables in:
# 1. Local environment: copy this file to `.env`
# 2. Vercel: Project Settings -> Environment Variables (Production & Preview)
# ==============================================================================

# --- SUPABASE CONFIGURATION (Required for Authentication & Database) ---
# Your Supabase project URL (e.g. https://blvugdimplgugqbeirwr.supabase.co)
VITE_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"

# Your Supabase Public / Anon Key (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Your Supabase Service Role Secret Key (Server-only, bypasses RLS for admin user lookups)
# Required for account status checking (getAccountStatus) and user management.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- SECURITY & ENCRYPTION (Server-only) ---
# 32-byte hexadecimal key used to encrypt ERP credentials at rest with AES-256-GCM.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ERP_TOKEN_ENCRYPTION_KEY=""

# --- AI INSIGHTS & LEAKAGE SCAN (Optional LLM Integration) ---
# Configure one of the following for AI-powered leakage analysis & recovery notice generation:
GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# GOOGLE_VERTEX_PROJECT=""
